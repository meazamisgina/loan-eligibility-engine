      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        896,
        0
      ],
      "id": "6e50fc22-57b8-4b02-9ad6-70ca9b871730",
      "name": "Demo Config"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Demo Config').first().json;\nconst aliases = String(cfg.demo_recipients ?? '').split(',').map(s => s.trim()).filter(Boolean);\nconst channel = String(cfg.transport ?? 'smtp');\n\nconst items = $('Fetch Matches').all();\nconst runId = items[0]?.json?.match_run_id ?? null;\nconst out = [];\n\nfor (let i = 0; i < Math.min(items.length, aliases.length); i++) {\n  const { user_id, name, products } = items[i].json;\n  const list = Array.isArray(products) ? products : [];\n  if (list.length === 0) continue;\n\n  const rows = list.map((p, idx) =>\n    `${idx + 1}. ${p.product_name} | interest rate: ${p.interest_rate ?? 'contact bank'}% | ${p.reason_text}`\n  ).join('\\n');\n\n  const text =\n    `Hello ${name},\\n\\nBased on your profile, you may qualify for these personal loans:\\n\\n` +\n    `${rows}\\n\\nNote: rates are indicative; final eligibility is decided by the lender.\\n\\n` +\n    `-- Loan Eligibility Engine (automated notification)`;\n\n  const subject = `${name}: ${list.length} loan product${list.length > 1 ? 's' : ''} you may qualify for`;\n\n  out.push({ json: { match_run_id: runId, user_id: String(user_id), name,\n                      recipient: aliases[i], subject, text, channel } });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
