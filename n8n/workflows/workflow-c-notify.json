    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "3d160c29-be25-4559-9dd4-277bd8b08b7a",
              "name": "demo_recipients",
              "value": "misginameaza+one@gmail.com,misginameaza+two@gmail.com",
              "type": "string"
            },
            {
              "id": "f413e9af-d26d-4b7d-8435-bc55e6d26b1a",
              "name": "transport",
              "value": "smtp",
              "type": "string"
            }
