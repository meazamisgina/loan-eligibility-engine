      "id": "7a09adc7-832a-4392-8700-df6c527462a0",
      "name": "Resolve Run"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.match_run_id, u.user_id, u.name, u.email,\n       jsonb_agg(jsonb_build_object(\n         'product_name', p.product_name,\n         'interest_rate', p.interest_rate,\n         'reason_text', m.reason_text\n       ) ORDER BY p.interest_rate ASC NULLS LAST, p.product_id ASC) AS products\nFROM matches m\nJOIN users u ON u.user_id = m.user_id\nJOIN loan_products p ON p.product_id = m.product_id\nWHERE m.match_run_id = COALESCE(\n  {{ $json.match_run_id ? \"'\" + $json.match_run_id + \"'::uuid\" : \"NULL::uuid\" }},\n  (SELECT match_run_id FROM match_runs WHERE status='completed' ORDER BY finished_at DESC LIMIT 1)\n)\nGROUP BY m.match_run_id, u.user_id, u.name, u.email\nORDER BY u.user_id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        672,
        0
      ],
      "id": "0d1c5267-9993-45f7-99d6-d82835756744",
      "name": "Fetch Matches",
