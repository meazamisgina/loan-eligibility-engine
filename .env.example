# Database (Postgres in Docker)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loan_engine
DATABASE_URL=postgresql://app:change-me@localhost:5432/loan_engine

# Local CSV upload drop-folder (on AWS this maps to S3)
UPLOAD_DIR=data/uploads

# LLM (DeepSeek - OpenAI Compatible)
LLM_API_KEY=your_actual_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Email: local dev uses Mailpit SMTP; production uses AWS SES
SMTP_HOST=mailpit
SMTP_PORT=1025

MATCH_WEBHOOK_URL=http://localhost:5678/webhook/match-run